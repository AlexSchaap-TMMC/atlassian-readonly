{
  "name": "atlassian-readonly-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Jira and Confluence Cloud tools for MCP clients",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSchaap-TMMC/atlassian-readonly-mcp.git"
  },
